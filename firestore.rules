rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsIncoming() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid;
    }

    function ownsExisting() {
      return signedIn()
        && resource.data.uid == request.auth.uid;
    }

    // One visitor/session record. Client may create and update only its own UID.
    match /MORZEA_Visitors/{sessionId} {
      allow create: if ownsIncoming();
      allow update: if ownsExisting()
        && request.resource.data.uid == resource.data.uid;
      allow read, delete: if false;
    }

    // Append-only interaction telemetry.
    match /MORZEA_Events/{eventId} {
      allow create: if ownsIncoming();
      allow read, update, delete: if false;
    }

    // Newsletter / future voluntary contact captures.
    match /MORZEA_Leads/{leadId} {
      allow create: if ownsIncoming();
      allow read, update, delete: if false;
    }

    // AI session metadata.
    match /MORZEA_AI_Sessions/{sessionId} {
      allow create: if ownsIncoming();
      allow update: if ownsExisting()
        && request.resource.data.uid == resource.data.uid;
      allow read, delete: if false;
    }

    // Append-only AI conversation logs.
    match /MORZEA_AI_Messages/{messageId} {
      allow create: if ownsIncoming();
      allow read, update, delete: if false;
    }

    // Frontend errors, append-only.
    match /MORZEA_Errors/{errorId} {
      allow create: if ownsIncoming();
      allow read, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
