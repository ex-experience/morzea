rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    /*
     * AUTH HELPERS
     */

    function signedIn() {

      return request.auth != null;

    }


    function ownsIncoming() {

      return signedIn()

        && request.resource.data.uid
           == request.auth.uid;

    }


    function ownsExisting() {

      return signedIn()

        && resource.data.uid
           == request.auth.uid;

    }



    /*
     * MORZÉA VISITORS
     */

    match /MORZEA_Visitors/{sessionId} {

      allow create:
        if ownsIncoming();


      allow update:

        if ownsExisting()

        && request.resource.data.uid
           == resource.data.uid;


      allow read, delete:
        if false;

    }



    /*
     * MORZÉA EVENTS
     */

    match /MORZEA_Events/{eventId} {

      allow create:
        if ownsIncoming();


      allow read,
            update,
            delete:
        if false;

    }



    /*
     * MORZÉA LEADS
     */

    match /MORZEA_Leads/{leadId} {

      allow create:
        if ownsIncoming();


      allow read,
            update,
            delete:
        if false;

    }



    /*
     * MORZÉA AI SESSIONS
     */

    match /MORZEA_AI_Sessions/{sessionId} {

      allow create:
        if ownsIncoming();


      allow update:

        if ownsExisting()

        && request.resource.data.uid
           == resource.data.uid;


      allow read,
            delete:
        if false;

    }



    /*
     * MORZÉA AI MESSAGES
     */

    match /MORZEA_AI_Messages/{messageId} {

      allow create:
        if ownsIncoming();


      allow read,
            update,
            delete:
        if false;

    }



    /*
     * MORZÉA FRONTEND ERRORS
     */

    match /MORZEA_Errors/{errorId} {

      allow create:
        if ownsIncoming();


      allow read,
            update,
            delete:
        if false;

    }



    /*
     * DEFAULT DENY
     *
     * Anything not explicitly allowed above
     * is blocked.
     */

    match /{document=**} {

      allow read, write:
        if false;

    }

  }

}
